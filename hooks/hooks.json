{
  "description": "多 Agent 编排的强制层：拦住共用工作区里的并发写（防止两个 worker 改同一文件互相覆盖丢代码），以及 worker 越权执行构建与 git 写操作。只对跑过 /am-setup 的项目生效，其余项目立即放行。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
